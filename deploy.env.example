# Copy this file to .env.production on the server. Never commit .env.production.

# Use http://localhost:3000 while testing through an SSH tunnel.
# Replace it with the final HTTPS domain after ICP filing and TLS setup.
APP_URL="http://localhost:3000"
PORT="3000"
SERVER_PORT="3001"

POSTGRES_DB="weekly_resume"
POSTGRES_USER="weekly_resume"
POSTGRES_PASSWORD="replace-with-a-long-random-password"

# Generate both secrets independently with: openssl rand -hex 32
AUTH_SECRET="replace-with-a-random-64-character-hex-value"
ENCRYPTION_SECRET="replace-with-another-random-64-character-hex-value"

# The production compose file uses local persistent storage instead of S3.
LOCAL_STORAGE_PATH="/app/data"
REDIS_URL="redis://redis:6379"

# Configure SMTP before enabling email verification and password reset delivery.
SMTP_HOST=""
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Weekly Resume <noreply@example.com>"
SMTP_SECURE="true"

# Keep public registration closed until the domain, ICP filing, SMTP and policies are ready.
FLAG_DISABLE_SIGNUPS="true"
FLAG_DISABLE_EMAIL_AUTH="false"
FLAG_DISABLE_IMAGE_PROCESSING="false"
FLAG_DISABLE_API_RATE_LIMIT="false"
FLAG_ALLOW_UNSAFE_AI_BASE_URL="false"
FLAG_ALLOW_UNSAFE_OAUTH_REDIRECT_URI="false"
